NODE_ENV=development
PORT=3000
# Persistent development database: Compose service postgres, host port 5432.
DATABASE_URL=postgresql://teamizer:teamizer@localhost:5432/teamizer?schema=public
# Destructive integration-test database: Compose service postgres-test, host port 5433.
TEST_DATABASE_URL=postgresql://teamizer:teamizer@localhost:5433/teamizer_test?schema=public
# Must match the Firebase project used by mobile and by the Admin credential.
FIREBASE_PROJECT_ID=your-firebase-project-id
PROPOSAL_RECEIPT_SECRET=replace-with-at-least-32-random-characters
# Readable absolute path; the account needs firebaseauth.users.get for guest conversion.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_MS=60000
PUSH_PROVIDER_TIMEOUT_MS=30000
EXPO_PUSH_ACCESS_TOKEN=
AVATAR_STORAGE_DIRECTORY=.data/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:3000
AVATAR_URL_SECRET=replace-with-an-independent-32-character-random-secret
AVATAR_MAX_UPLOAD_BYTES=5000000
AVATAR_URL_TTL_SECONDS=3600


gcloud run deploy teamizer-api-test \
  --source . \
  --region europe-west1 \
  --service-account teamizer-api@teamizer-test.iam.gserviceaccount.com \
  --allow-unauthenticated \
  --set-env-vars FIREBASE_PROJECT_ID=teamizer-eb26f,SCHEDULER_ENABLED=false \
  --set-secrets DATABASE_URL=teamizer-database-url:latest,PROPOSAL_RECEIPT_SECRET=teamizer-proposal-receipt-secret:latest,AVATAR_URL_SECRET=teamizer-avatar-url-secret:latest