{
  "name": "teamizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.10.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @teamizer/api prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @teamizer/api prisma:migrate:deploy",
    "prisma:validate": "pnpm --filter @teamizer/api prisma:validate",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.11.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.11"
  }
}
